# Copy to .env and edit. Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SPEECH_API_KEYS=dialer:CHANGE_ME_1,console:CHANGE_ME_2
SPEECH_DOMAIN=speech.example.com

# Models
SPEECH_STT_MODEL=large-v3-turbo
SPEECH_STT_COMPUTE_TYPE=float16
SPEECH_STT_LANGUAGE=en
SPEECH_TTS_VOICE=af_heart

# Capacity (raise only after load testing on your GPU)
SPEECH_STT_CONCURRENCY=1
SPEECH_TTS_CONCURRENCY=1

# Optional voice cloning (start with: docker compose --profile clone up -d)
# SPEECH_CLONE_URL=http://clone:8100
# SPEECH_CLONE_TOKEN=CHANGE_ME_LONG_RANDOM
